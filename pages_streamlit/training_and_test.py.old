"""
Page Streamlit pour Training Dataset et Test Client.

Permet de :
1. Training dataset : analyser un dataset complet et générer training_state
2. Test client : tester un client avec RAG+DOCX en utilisant training_state
"""
import streamlit as st
import sys
from pathlib import Path
from typing import Optional, Dict, Any
import json

# Ajouter le projet au path
project_root = Path(__file__).parent.parent
if str(project_root) not in sys.path:
    sys.path.insert(0, str(project_root))

from src.rhpro.dataset_training import (
    discover_client_folders,
    analyze_dataset,
    export_training_artifacts,
    load_training_state,
)
from src.rhpro.client_finder import find_client_folders
from src.rhpro.report_generator import generate_report_from_normalized
from src.rhpro.client_scanner import scan_client_folder
from src.rhpro.client_normalizer import normalize_client_to_sandbox


def browse_directory(label: str, help_text: str = "") -> Optional[str]:
    """Permet de sélectionner un dossier via tkinter ou saisie manuelle."""
    col1, col2 = st.columns([3, 1])
    
    with col1:
        path_input = st.text_input(
            label,
            value=st.session_state.get(f"path_{label}", ""),
            help=help_text,
            key=f"input_{label}",
        )
    
    with col2:
        st.write("")
        st.write("")
        if st.button("📁 Browse", key=f"browse_{label}"):
            try:
                import tkinter as tk
                from tkinter import filedialog
                
                root = tk.Tk()
                root.withdraw()
                root.attributes('-topmost', True)
                
                folder_path = filedialog.askdirectory(
                    title=f"Sélectionner : {label}",
                )
                
                if folder_path:
                    st.session_state[f"path_{label}"] = folder_path
                    st.rerun()
            
            except Exception as e:
                st.error(f"Erreur browse : {e}")
    
    return path_input if path_input else None


def show_training_dataset():
    """Écran A : Training dataset."""
    st.subheader("🎓 Training Dataset")
    st.markdown("---")
    
    st.markdown("""
    Analysez un dataset complet de dossiers clients pour extraire :
    - Patterns de structure (dossiers, fichiers)
    - Titres/sections fréquents (y compris unknown)
    - Statistiques de longueur par section
    - Recommandations d'amélioration
    
    Le **training_state.json** généré sera réutilisable pour améliorer la génération RAG+DOCX.
    """)
    
    # Browse dataset
    dataset_root = browse_directory(
        "Dataset racine",
        "Dossier contenant les clients (BATCH ou structure hétérogène)"
    )
    
    if not dataset_root or not Path(dataset_root).exists():
        st.warning("⚠️ Veuillez sélectionner un dataset valide")
        return
    
    st.success(f"✅ Dataset : `{dataset_root}`")
    
    # Configuration
    col1, col2, col3 = st.columns(3)
    
    with col1:
        scan_depth = st.number_input(
            "Profondeur scan",
            min_value=1,
            max_value=5,
            value=3,
            help="Profondeur de recherche pour structure hétérogène"
        )
    
    with col2:
        limit = st.number_input(
            "Limite clients",
            min_value=0,
            max_value=1000,
            value=0,
            help="0 = tous les clients"
        )
    
    with col3:
        merge_existing = st.checkbox(
            "Merge avec existant",
            value=False,
            help="Fusionner avec training_state existant (incrémental)"
        )
    
    # Output directory
    out_dir = st.text_input(
        "Dossier sortie",
        value="output/training",
        help="Où sauvegarder les artefacts"
    )
    
    # Lancer training
    if st.button("🚀 Lancer Training", type="primary"):
        with st.spinner("🔍 Découverte des clients..."):
            try:
                client_folders = discover_client_folders(
                    dataset_root,
                    scan_depth=scan_depth
                )
                
                st.info(f"📁 {len(client_folders)} clients détectés")
                
                if limit > 0:
                    client_folders = client_folders[:limit]
                    st.info(f"🎯 Limitation à {len(client_folders)} clients")
            
            except Exception as e:
                st.error(f"❌ Erreur découverte : {e}")
                return
        
        with st.spinner("📊 Analyse du dataset..."):
            try:
                result = analyze_dataset(
                    dataset_root,
                    out_dir=out_dir,
                    scan_depth=scan_depth,
                    limit=limit if limit > 0 else None
                )
                
                st.success("✅ Analyse terminée !")
            
            except Exception as e:
                st.error(f"❌ Erreur analyse : {e}")
                import traceback
                st.code(traceback.format_exc())
                return
        
        with st.spinner("💾 Export des artefacts..."):
            try:
                paths = export_training_artifacts(
                    result,
                    out_dir=out_dir,
                    merge_existing=merge_existing
                )
                
                st.success("✅ Export terminé !")
                
                # Afficher les résultats
                st.markdown("---")
                st.markdown("### 📊 Résultats")
                
                col1, col2, col3, col4 = st.columns(4)
                
                with col1:
                    st.metric(
                        "Clients analysés",
                        result.stats["total_clients"]
                    )
                
                with col2:
                    st.metric(
                        "GOLD détectés",
                        result.stats["gold_detected"],
                        f"{result.stats['gold_detection_rate']:.0%}"
                    )
                
                with col3:
                    st.metric(
                        "Pipeline ready",
                        result.stats["pipeline_ready"],
                        f"{result.stats['pipeline_ready_rate']:.0%}"
                    )
                
                with col4:
                    st.metric(
                        "Sources moy.",
                        f"{result.stats['sources_stats']['mean']:.1f}"
                    )
                
                # Titres inconnus
                if result.patterns.get("unknown_titles_top10"):
                    st.markdown("### 📝 Titres Inconnus (Top 10)")
                    
                    unknown_data = []
                    for title, count in result.patterns["unknown_titles_top10"].items():
                        unknown_data.append({"Titre": title, "Occurrences": count})
                    
                    if unknown_data:
                        st.dataframe(unknown_data, use_container_width=True)
                
                # Recommandations
                if result.recommendations:
                    st.markdown("### 💡 Recommandations")
                    for rec in result.recommendations:
                        st.info(rec)
                
                # Liens vers les fichiers
                st.markdown("### 📁 Fichiers Générés")
                
                training_state_path = Path(paths["training_state"])
                
                col1, col2 = st.columns(2)
                
                with col1:
                    if st.button("📄 Ouvrir dossier output"):
                        import subprocess
                        subprocess.run(["open", str(training_state_path.parent)])
                
                with col2:
                    if st.button("🎯 Afficher training_state"):
                        with open(training_state_path, "r") as f:
                            state = json.load(f)
                        st.json(state)
                
                # Sauvegarder le path dans session pour l'onglet Test
                st.session_state["last_training_state"] = str(training_state_path)
            
            except Exception as e:
                st.error(f"❌ Erreur export : {e}")
                import traceback
                st.code(traceback.format_exc())


def show_test_client():
    """Écran B : Test un client."""
    st.subheader("🧪 Test Client (RAG + DOCX)")
    st.markdown("---")
    
    st.markdown("""
    Testez la génération RAG+DOCX sur un client spécifique.
    
    Le **training_state** sera utilisé pour améliorer la qualité de génération.
    """)
    
    # Sélection du mode
    mode = st.radio(
        "Mode de sélection",
        options=["📁 Browse dossier client direct", "🔍 Recherche dans dataset"],
        horizontal=True
    )
    
    client_path = None
    
    if mode == "📁 Browse dossier client direct":
        client_path = browse_directory(
            "Dossier client",
            "Dossier contenant les sources du client"
        )
    
    else:  # Recherche
        dataset_root = browse_directory(
            "Dataset racine",
            "Dossier contenant les clients"
        )
        
        if dataset_root and Path(dataset_root).exists():
            search_query = st.text_input(
                "🔎 Recherche client (nom)",
                placeholder="Ex: ARIFI, Karaoui, Malik",
                help="Recherche floue (insensible à la casse)"
            )
            
            if search_query:
                try:
                    matches = find_client_folders(
                        dataset_root,
                        search_query,
                        min_score=0.3,
                        max_results=5
                    )
                    
                    if matches:
                        st.markdown(f"**{len(matches)} résultat(s)** :")
                        
                        # Afficher les matches
                        for i, match in enumerate(matches):
                            col1, col2 = st.columns([3, 1])
                            
                            with col1:
                                st.markdown(f"{i+1}. **{match['folder_name']}** (score: {match['score']:.2f})")
                                st.caption(f"`{match['folder_path']}`")
                            
                            with col2:
                                if st.button(f"Sélectionner", key=f"select_{i}"):
                                    client_path = match['folder_path']
                                    st.session_state["selected_client_path"] = client_path
                                    st.rerun()
                    else:
                        st.warning("Aucun client trouvé")
                
                except Exception as e:
                    st.error(f"Erreur recherche : {e}")
        
        # Utiliser le client sélectionné
        if "selected_client_path" in st.session_state:
            client_path = st.session_state["selected_client_path"]
    
    if not client_path or not Path(client_path).exists():
        st.info("👆 Sélectionnez un client pour continuer")
        return
    
    st.success(f"✅ Client : `{Path(client_path).name}`")
    
    # Sélection training_state
    st.markdown("### 🎯 Training State")
    
    use_training_state = st.checkbox(
        "Utiliser training_state",
        value=True,
        help="Améliore la génération avec les patterns appris"
    )
    
    training_state_path = None
    training_state = None
    
    if use_training_state:
        col1, col2 = st.columns([3, 1])
        
        with col1:
            default_path = st.session_state.get("last_training_state", "")
            training_state_path = st.text_input(
                "Chemin training_state.json",
                value=default_path,
                help="Chemin vers le fichier training_state.json"
            )
        
        with col2:
            st.write("")
            st.write("")
            if st.button("📁 Browse state", key="browse_state"):
                try:
                    import tkinter as tk
                    from tkinter import filedialog
                    
                    root = tk.Tk()
                    root.withdraw()
                    root.attributes('-topmost', True)
                    
                    file_path = filedialog.askopenfilename(
                        title="Sélectionner training_state.json",
                        filetypes=[("JSON", "*.json")],
                    )
                    
                    if file_path:
                        st.session_state["last_training_state"] = file_path
                        st.rerun()
                
                except Exception as e:
                    st.error(f"Erreur browse : {e}")
        
        if training_state_path and Path(training_state_path).exists():
            try:
                training_state = load_training_state(training_state_path)
                st.success(f"✅ Training state chargé ({training_state['clients_analyzed']} clients)")
            except Exception as e:
                st.error(f"❌ Erreur chargement : {e}")
    
    # Configuration génération
    st.markdown("### ⚙️ Configuration")
    
    col1, col2 = st.columns(2)
    
    with col1:
        output_dir = st.text_input(
            "Dossier sortie",
            value="output/test_client",
            help="Où sauvegarder les outputs"
        )
    
    with col2:
        strict_mode = st.checkbox(
            "Mode strict",
            value=True,
            help="Si non trouvé → 'Non renseigné'"
        )
    
    template_path = st.text_input(
        "Template DOCX (optionnel)",
        value="",
        help="Laisser vide pour template par défaut"
    )
    
    # Lancer génération
    if st.button("🚀 Run (RAG + DOCX)", type="primary"):
        progress_bar = st.progress(0)
        status_text = st.empty()
        
        try:
            # Étape 1: Scanner le client
            status_text.text("📊 Scan du client...")
            progress_bar.progress(10)
            
            scan_result = scan_client_folder(client_path)
            
            # Étape 2: Normaliser en sandbox
            status_text.text("🔧 Normalisation...")
            progress_bar.progress(30)
            
            sandbox_root = Path(output_dir) / "sandbox"
            sandbox_root.mkdir(parents=True, exist_ok=True)
            
            normalized_path = normalize_client_to_sandbox(
                client_folder_path=client_path,
                sandbox_root=str(sandbox_root),
                batch_name="TEST",
                create_normalized_alias=False
            )
            
            # Étape 3: Générer rapport
            status_text.text("🤖 Génération RAG + DOCX...")
            progress_bar.progress(50)
            
            result = generate_report_from_normalized(
                normalized_client_path=normalized_path,
                output_dir=output_dir,
                template_path=template_path if template_path else None,
                strict_mode=strict_mode,
                training_state=training_state,
            )
            
            progress_bar.progress(100)
            status_text.text("✅ Génération terminée !")
            
            # Afficher résultats
            st.markdown("---")
            st.markdown("### 📊 Résultats")
            
            # Métriques
            if result.get("metrics"):
                metrics = result["metrics"]
                
                col1, col2, col3, col4 = st.columns(4)
                
                with col1:
                    st.metric(
                        "Couverture",
                        f"{metrics.get('weighted_coverage', 0):.1f}%"
                    )
                
                with col2:
                    st.metric(
                        "Couv. requise",
                        f"{metrics.get('required_coverage', 0):.1f}%"
                    )
                
                with col3:
                    st.metric(
                        "Confiance",
                        f"{metrics.get('avg_confidence', 0):.2f}"
                    )
                
                with col4:
                    st.metric(
                        "Qualité",
                        f"{metrics.get('quality_score', 0):.2f}"
                    )
            
            # Validation
            if result.get("validation"):
                validation = result["validation"]
                
                status = validation["status"]
                status_emoji = {"GO": "✅", "NO_GO": "❌", "DRAFT": "⚠️"}.get(status, "❓")
                
                st.markdown(f"### {status_emoji} Status : **{status}**")
                
                if validation.get("reasons"):
                    st.markdown("**Raisons** :")
                    for reason in validation["reasons"]:
                        st.markdown(f"- {reason}")
            
            # Outputs
            st.markdown("### 📁 Fichiers Générés")
            
            outputs = result.get("outputs", {})
            
            for key, path in outputs.items():
                if path:
                    col1, col2 = st.columns([3, 1])
                    
                    with col1:
                        st.code(path, language=None)
                    
                    with col2:
                        if st.button(f"📄 Ouvrir", key=f"open_{key}"):
                            import subprocess
                            subprocess.run(["open", path])
            
            # Bouton dossier output
            if st.button("📂 Ouvrir dossier output"):
                import subprocess
                subprocess.run(["open", output_dir])
        
        except Exception as e:
            st.error(f"❌ Erreur : {e}")
            import traceback
            st.code(traceback.format_exc())


def show_training_and_test_page():
    """Page principale avec 2 onglets."""
    st.title("🎓 Training & Test Client")
    
    tab1, tab2 = st.tabs(["🎓 Training Dataset", "🧪 Test Client"])
    
    with tab1:
        show_training_dataset()
    
    with tab2:
        show_test_client()


if __name__ == "__main__":
    show_training_and_test_page()
